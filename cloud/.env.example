# Copy to .env on the cloud host. Never commit the real .env file.
AI_DOMAIN=ai.example.com

# Built and pushed by the fork's successful Cloud inference image workflow.
# GHCR package read access/visibility must be confirmed before deployment.
NINFER_IMAGE=ghcr.io/6900-sudo/ninfer-all:cloud-cuda13.4-sm86-2f15976d6f1afb2b400d5f9105f8a018417ac253
NINFER_MODEL_ID=qwen38-27b

# Generate two different long random values. Do not reuse either value elsewhere.
GATEWAY_API_KEY=replace-with-a-long-random-client-key
NINFER_API_KEY=replace-with-a-different-long-random-engine-key

NINFER_MAX_CONTEXT=32768
MAX_REQUEST_BYTES=2097152
MAX_OUTPUT_TOKENS=4096
UPSTREAM_TIMEOUT_SECONDS=600
MAX_REQUESTS_PER_MINUTE=30
